# Makefile for hjhint
# Usage:
#   make            # build ./hjhint
#   make clean      # remove binary
# Optional:
#   make CFLAGS='-O2 -g -Wall -Wextra'

TARGET := hjhint
SRC    := hjhint.c

# Default flags (can be overridden on the command line)
CFLAGS ?= -O2 -Wall -Wextra -std=c11 -D_GNU_SOURCE
LDFLAGS ?=

OS := $(shell uname -s)

# Nothing special is required on Linux; on non-Linux we rely on the
# __linux__ guards already in the source.
ifeq ($(OS),Linux)
  # Linux: ok
else
  # Hurd / other: no special flags needed; linux-specific bits are #ifdef __linux__
endif

$(TARGET): $(SRC)
	$(CC) $(CFLAGS) -o $@ $(SRC) $(LDFLAGS)

.PHONY: clean
clean:
	rm -f $(TARGET)

